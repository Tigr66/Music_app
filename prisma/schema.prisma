generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Artist { 
  id        Int     @id @default(autoincrement()) 
  name      String 
  photo     String
  info      String @db.Text
  albums    Album[]
} 

model Album { 
  id            Int     @id @default(autoincrement()) 
  title         String
  artist        Artist    @relation(fields: [artistId], references: [id]) 
  artistId      Int
  cover         String
  publishedAt   DateTime 

  tracks Track[]
} 

model Track {
  id        Int    @id @default(autoincrement())
  title     String
  duration  String
  album     Album    @relation(fields: [albumId], references: [id]) 
  albumId   Int
}
